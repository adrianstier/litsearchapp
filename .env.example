# Literature Search Application - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# ENVIRONMENT
# =============================================================================
# Options: development, staging, production
ENVIRONMENT=development

# Debug mode (true/false)
DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# =============================================================================
# API KEYS (optional - will work without these but with limitations)
# =============================================================================
# Anthropic Claude API key (for AI synthesis features)
ANTHROPIC_API_KEY=

# OpenAI API key (alternative for AI synthesis)
OPENAI_API_KEY=

# SerpAPI key (for enhanced Google Scholar access - paid)
SERPAPI_KEY=

# Crossref mailto (for polite pool access - free, recommended)
CROSSREF_MAILTO=your-email@example.com

# =============================================================================
# RATE LIMITS (requests per second)
# =============================================================================
PUBMED_RATE_LIMIT=3
SCHOLAR_RATE_LIMIT=0.5
ARXIV_RATE_LIMIT=1
CROSSREF_RATE_LIMIT=2
SEMANTIC_SCHOLAR_RATE_LIMIT=2
OPENALEX_RATE_LIMIT=10

# =============================================================================
# DIRECTORIES
# =============================================================================
# Where to store downloaded PDFs
PAPERS_DIR=./papers

# Where to store cached data
CACHE_DIR=./cache

# Where to store output files
OUTPUT_DIR=./output

# =============================================================================
# DATABASE
# =============================================================================
# SQLite database path
DATABASE_URL=sqlite:///database/papers.db

# =============================================================================
# CACHE SETTINGS
# =============================================================================
# Cache expiry in days
CACHE_EXPIRY_DAYS=30

# In-memory cache TTL in seconds
CACHE_TTL=300

# Maximum cache entries
CACHE_MAX_SIZE=1000

# =============================================================================
# SEARCH SETTINGS
# =============================================================================
# Default maximum results per source
DEFAULT_MAX_RESULTS=50

# Maximum concurrent API requests
MAX_CONCURRENT_REQUESTS=5

# Request timeout in seconds
REQUEST_TIMEOUT=30

# =============================================================================
# FRONTEND (Vite environment variables must start with VITE_)
# =============================================================================
VITE_API_URL=http://localhost:8000/api
